# Port server Express (default 3000)
PORT=3000
# Lokasi file database SQLite (default backend/data/skincare.db)
# DB_PATH=./data/skincare.db
# Isi dummy data saat database masih kosong (true/false)
SEED=true

# Kunci penanda tangan cookie login. Isi string acak panjang (openssl rand -hex 32).
# Jika kosong, kunci dibuat acak tiap server start sehingga semua sesi berakhir saat restart.
# WAJIB diisi di Vercel.
AUTH_SECRET=
# Akun uji yang dibuat otomatis saat tabel users masih kosong (hanya jika SEED=true)
SEED_USER_EMAIL=admin@skincare.test
SEED_USER_PASSWORD=Admin123!
# Set true jika dilayani lewat HTTPS (otomatis aktif di Vercel)
COOKIE_SECURE=false
